{
    "manifest_version": 3,
    "name": "Web Tracking Detector",
    "version": "1.0.0",
    "description": "An extension to detect web tracking scripts on visited websites.",
    "permissions": ["webRequest", "webNavigation"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/fp-bridge.js", "content/http-bridge.js"],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["page/fp-recorder.js", "page/http-recorder.js", "common/fp-apis.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "action": {
        "default_popup": "ui/popup.html",
        "default_title": "Web Tracking Detector"
    }
}
